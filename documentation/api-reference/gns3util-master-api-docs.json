{
    "openapi": "3.0.0",
    "info": {
        "description": "API for gns3util cluster management",
        "title": "gns3util cluster master API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/v1/auth/grant": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Grants a permission scope to a specific user",
                "tags": [
                    "auth"
                ],
                "summary": "Grant access scope to user",
                "parameters": [
                    {
                        "description": "User ID",
                        "name": "user_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Scope to grant",
                        "name": "scope",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/revoke": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Revokes all permission scopes from a user",
                "tags": [
                    "auth"
                ],
                "summary": "Revoke user access",
                "parameters": [
                    {
                        "description": "User ID",
                        "name": "user_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/status": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns all nodes in the cluster with their status and basic info",
                "tags": [
                    "discovery"
                ],
                "summary": "Return nodes in cluster",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/models.GetNodesResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/token": {
            "post": {
                "description": "Mints a new JWT token for user authentication",
                "tags": [
                    "auth"
                ],
                "summary": "Create authentication token",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/models.CreateTokenRequest"
                            }
                        }
                    },
                    "description": "Token creation request",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/cluster/join": {
            "post": {
                "description": "Signs CSR and adds node to etcd cluster",
                "tags": [
                    "cluster"
                ],
                "summary": "Join cluster as a new node",
                "parameters": [
                    {
                        "description": "Bearer JOIN_TOKEN",
                        "name": "Authorization",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/models.JoinClusterRequest"
                            }
                        }
                    },
                    "description": "Join request with CSR",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/models.JoinClusterResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/cluster/join/filestore": {
            "post": {
                "description": "Signs CSR for filestore node",
                "tags": [
                    "cluster"
                ],
                "summary": "Join filestore cluster",
                "parameters": [
                    {
                        "description": "Bearer JOIN_TOKEN",
                        "name": "Authorization",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/models.JoinFilestoreRequest"
                            }
                        }
                    },
                    "description": "Join request with CSR",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/models.JoinFilestoreResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/helpers.APIErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "description": "Type \"Bearer\" followed by a space and JWT token.",
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            }
        },
        "schemas": {
            "helpers.APIErrorResponse": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "example": "unauthorized"
                    },
                    "details": {
                        "type": "string",
                        "example": "invalid or missing join token"
                    },
                    "error": {
                        "type": "string",
                        "example": "Unauthorized"
                    }
                }
            },
            "models.AuthStatusResponse": {
                "type": "object",
                "properties": {
                    "authenticated": {
                        "type": "boolean"
                    },
                    "scopes": {
                        "type": "string"
                    },
                    "user": {
                        "type": "string"
                    }
                }
            },
            "models.CreateTokenRequest": {
                "type": "object",
                "properties": {
                    "role": {
                        "type": "string"
                    },
                    "user_id": {
                        "type": "string"
                    }
                }
            },
            "models.GetNodesResponse": {
                "type": "object",
                "properties": {
                    "nodes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/models.NodeInfo"
                        }
                    }
                }
            },
            "models.JoinClusterRequest": {
                "type": "object",
                "properties": {
                    "csr_pem": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "name": {
                        "type": "string"
                    },
                    "peer_urls": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "models.JoinClusterResponse": {
                "type": "object",
                "properties": {
                    "ca_cert": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "cert_pem": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "cluster": {
                        "type": "string"
                    },
                    "member_id": {
                        "type": "integer"
                    }
                }
            },
            "models.JoinFilestoreRequest": {
                "type": "object",
                "properties": {
                    "api_port": {
                        "type": "integer"
                    },
                    "csr": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "ip_address": {
                        "type": "string"
                    }
                }
            },
            "models.JoinFilestoreResponse": {
                "type": "object",
                "properties": {
                    "ca_cert": {
                        "type": "string"
                    },
                    "node_cert": {
                        "type": "string"
                    }
                }
            },
            "models.NodeInfo": {
                "type": "object",
                "properties": {
                    "api_port": {
                        "type": "integer"
                    },
                    "id": {
                        "type": "string"
                    },
                    "ip": {
                        "type": "string"
                    },
                    "type": {
                        "$ref": "#/components/schemas/models.NodeType"
                    }
                }
            },
            "models.NodeType": {
                "type": "integer",
                "enum": [
                    0,
                    1,
                    2
                ],
                "x-enum-varnames": [
                    "NodeTypeMaster",
                    "NodeTypeWorker",
                    "NodeTypeFilestore"
                ]
            }
        }
    }
}