{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gns3util/scaffoldctl/schema.json",
  "title": "scaffoldctl package spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "package", "client", "client_methods"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "service"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vcs": {
              "type": "string",
              "enum": ["git", "jj"]
            },
            "commit_id": {
              "type": "string"
            },
            "change_id": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_file", "default_section"],
      "properties": {
        "target_file": {
          "type": "string",
          "minLength": 1
        },
        "default_section": {
          "type": "string",
          "enum": [
            "transport",
            "auth",
            "cluster",
            "users",
            "roles",
            "jobs",
            "buckets",
            "files",
            "backups",
            "vm_images",
            "bucket_permissions",
            "file_permissions",
            "public_tokens",
            "transfers"
          ]
        },
        "endpoint_group": {
          "type": "string"
        }
      }
    },
    "client_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "http_method", "url_expr", "response"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "enum": [
              "transport",
              "auth",
              "cluster",
              "users",
              "roles",
              "jobs",
              "buckets",
              "files",
              "backups",
              "vm_images",
              "bucket_permissions",
              "file_permissions",
              "public_tokens",
              "transfers"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "http_method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          },
          "url_expr": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "body": {
                "type": "boolean"
              },
              "arg_name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "body": {
                      "const": true
                    }
                  },
                  "required": ["body"]
                },
                "then": {
                  "required": ["arg_name", "type"]
                }
              }
            ]
          },
          "response": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pointer_type": {
                "type": "string"
              },
              "value_type": {
                "type": "string"
              },
              "decode_var": {
                "type": "string"
              },
              "decode_error": {
                "type": "string"
              },
              "no_response": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "no_response": {
                      "const": true
                    }
                  },
                  "required": ["no_response"]
                },
                "then": {},
                "else": {
                  "required": ["pointer_type", "value_type", "decode_var", "decode_error"]
                }
              }
            ]
          }
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_file": {
          "type": "string"
        },
        "parent_file": {
          "type": "string"
        },
        "parent_factory": {
          "type": "string"
        },
        "command_factory": {
          "type": "string"
        },
        "use": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "short": {
          "type": "string"
        },
        "long": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "auth_mode": {
          "type": "string",
          "enum": ["cluster-only", "flexible", "none"]
        },
        "group_id": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "fields"],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string"
                    },
                    "json": {
                      "type": "string"
                    },
                    "header": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cli_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "use", "short"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "factory": {
            "type": "string"
          },
          "use": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "short": {
            "type": "string",
            "minLength": 1
          },
          "long": {
            "type": "string"
          },
          "example": {
            "type": "string"
          },
          "auth_mode": {
            "type": "string",
            "enum": ["cluster-only", "flexible", "none"]
          },
          "group_id": {
            "type": "string"
          },
          "cobra_args": {
            "type": "string"
          },
          "client_method": {
            "type": "string"
          },
          "helper": {
            "type": "string"
          },
          "positionals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "usage": {
                  "type": "string"
                },
                "client_arg": {
                  "type": "string"
                }
              }
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "usage"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "shorthand": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": ["string", "int64", "bool"]
                },
                "default": {
                  "type": "string"
                },
                "usage": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "model_field": {
                  "type": "string"
                }
              }
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "response_field": {
                "type": "string"
              },
              "row_type": {
                "type": "string"
              },
              "empty_message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
